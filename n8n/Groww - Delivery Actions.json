      "name": "Get Approved Audit Record"
    },
    {
      "parameters": {
        "jsCode": "const req=$('Hash Incoming Payload').first().json;\nconst rows=$input.all().map(i=>i.json).filter(r=>r.run_id===req.run_id);\nif(rows.length!==1) throw new Error('No unique persisted approval record');\nconst row=rows[0];\nif(row.status!=='approved'||row.payload_hash!==req.payload_hash||row.payload_hash!==$('Check Tool Inputs').first().json.payload_hash||row.payload_json!==req.payload_json) throw new Error('Not approved or altered payload');\n// Crypto node recomputed the hash; `payload_hash` is overwritten with the digest.\nconst op=req.operation;\nconst key=op==='append_to_doc'?'doc_status':'draft_status';\nif(row[key]!=='pending') throw new Error('Operation already claimed or completed');\nconst p=JSON.parse(req.payload_json);\nif(!Array.isArray(p.quote_checks)||p.quote_checks.length!==3||!p.quote_checks.every(q=>q.matches_cleaned_source===true)) throw new Error('Quote evidence absent');\nreturn [{json:{operation:op,run_id:req.run_id,payload_hash:req.payload_hash,payload_json:req.payload_json,\n  doc_status:row.doc_status,draft_status:row.draft_status}}];"
      },
