      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst input = $input.first().json;\nconst operation = String(input.operation ?? '').trim();\nconst runId = String(input.run_id ?? '').trim();\nconst payloadHash = String(input.payload_hash ?? '').trim();\nconst payloadJson = String(input.payload_json ?? '').trim();\nconst errors = [];\nif (!runId) errors.push('Missing run_id');\nif (!payloadHash) errors.push('Missing payload_hash');\nif (!payloadJson) errors.push('Missing payload_json');\nif (!operation) errors.push('Missing operation');\nlet computedHash = null;\ntry { computedHash = crypto.createHash('sha256').update(payloadJson).digest('hex'); } catch (e) { errors.push('Cannot compute payload hash: ' + e.message); }\nif (computedHash && computedHash !== payloadHash) errors.push('Payload hash mismatch \u2014 payload may have been altered');\nif (errors.length > 0) {\n  return [{ json: { authorized: false, errors, run_id: runId, operation: operation } }];\n}\nreturn [{ json: { authorized: true, errors: [], run_id: runId, operation: operation, payload_hash: payloadHash, payload_json: payloadJson, verified_at: new Date().toISOString() } }];"
      },
