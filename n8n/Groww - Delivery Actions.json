    {
      "parameters": {
        "jsCode": "const d=$input.first().json;\nconst op=String(d.operation??'');\nif (!['append_to_doc','create_email_draft'].includes(op)) throw new Error('Forbidden operation');\nif (!/^[a-zA-Z0-9_-]{4,128}$/.test(String(d.run_id??''))) throw new Error('Invalid run ID');\nif (!/^[a-f0-9]{64}$/i.test(String(d.payload_hash??''))) throw new Error('Missing SHA-256 payload hash');\nif (typeof d.payload_json!=='string'||d.payload_json.length<10||d.payload_json.length>25000) throw new Error('Invalid payload');\nconst p=JSON.parse(d.payload_json);\nif (p.product!=='Groww'||!p.weekly_pulse||!Array.isArray(p.explanation_bullets)||p.explanation_bullets.length>6) throw new Error('Payload missing required fields');\nreturn [{json:{operation:op,run_id:d.run_id,payload_hash:d.payload_hash,payload_json:d.payload_json}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        272
      ],
